# ================================
# DATABASE CONFIGURATION
# ================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME= 

# ================================
# LLM API KEYS
# ================================
# Groq API (Primary)
GROQ_API_KEY=
GROQ_MODEL=
GROQ_RPM_LIMIT=
GROQ_TOKENS_PER_MINUTE=
GOOGLE_TRANSLATE_API_KEY=
# OpenAI API (Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RPM_LIMIT=
OPENAI_TOKENS_PER_MINUTE=

# ================================
# SARVAM AI API (Multi-Language)
# ================================
# Get your API key from: https://www.sarvam.ai/
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TRANSLATE_MODEL=
SARVAM_DEFAULT_SPEAKER=
SARVAM_DEFAULT_LANGUAGE=

# ================================
# SPEECH-TO-TEXT API KEYS
# ================================
# Deepgram API (Fallback for STT)
DEEPGRAM_API_KEY=
#whisper runs locally, no API key needed


# ================================
# APPLICATION SETTINGS
# ================================
APP_HOST=
APP_PORT=
LOG_LEVEL=
ENVIRONMENT=
ENABLE_SQL_FLOW=


# ================================
# AWS S3
# ================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=


# ================================
# LOCAL DEVELOPMENT — Dashboard URLs
# ================================
# These override the production default (test-ai.krushiratn.com) in dashboard.py.
# Keep these for local testing. On Streamlit Cloud, these are NOT set,
# so the dashboard automatically connects to production.
HEALTH_CHECK_URL=http://localhost:8000/health
WS_CHAT_URL=ws://localhost:8000/ws/chat


# ================================
# WEBSOCKET SETTINGS
# ================================
WS_MESSAGE_QUEUE_SIZE=100
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# ================================
# TTS SETTINGS
# ================================
TTS_PROVIDER=sarvam
TTS_LANGUAGE=en-IN
TTS_SPEED=1.0

# ================================
# FILE PATHS
# ================================
SCHEMA_DIR=app/schemas
TOOLS_DIR=app/schemas/tools
SCHEMA_PRIVACY_POLICY_PATH=app/schemas/privacy_policy.json
