# ================================
# APP CONFIG
# ================================
ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENABLE_SQL_FLOW=true

# ================================
# DATABASE CONFIGURATION (RDS)
# ================================
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_db_password
DB_NAME=chatbot_db

# ================================
# AWS S3
# ================================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=krushiratn-database-backup

# ================================
# LLM API KEYS
# ================================
GROQ_API_KEY=
GROQ_MODEL=
GROQ_RPM_LIMIT=
GROQ_TOKENS_PER_MINUTE=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RPM_LIMIT=
OPENAI_TOKENS_PER_MINUTE=

# ================================
# SARVAM AI API
# ================================
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TRANSLATE_MODEL=
SARVAM_DEFAULT_SPEAKER=
SARVAM_DEFAULT_LANGUAGE=

# ================================
# OTHER APIs
# ================================
DEEPGRAM_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# ================================
# WEBSOCKET SETTINGS
# ================================
WS_MESSAGE_QUEUE_SIZE=
WS_PING_INTERVAL=
WS_PING_TIMEOUT=

# ================================
# TTS SETTINGS
# ================================
TTS_PROVIDER=
TTS_LANGUAGE=
TTS_SPEED=

# ================================
# FILE PATHS
# ================================
SCHEMA_DIR=app/schemas
TOOLS_DIR=app/schemas/tools